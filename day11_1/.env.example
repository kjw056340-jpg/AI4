# Supabase Project Settings > API: 서버 전용 secret 또는 legacy service_role 키
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVER_SECRET_KEY
# 쇼핑몰 세션 폐기 검증용 서명키 (Supabase JWT 서명키가 아님).
# python -c "import secrets; print(secrets.token_urlsafe(48))" 로 생성
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
# Access token 만료는 Supabase Auth 설정을 따릅니다. 앱 쿠키 세션은 최대 7일입니다.
# 실DB 통합 테스트 전용. Supabase 연결 문자열, 앱 실행에는 불필요
# TEST_DATABASE_URL=postgresql://...
